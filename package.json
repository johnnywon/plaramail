{
	"name": "plaramail",
	"version": "0.9.8",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"cloudflare": {
		"label": "PlaraMail",
		"products": [
			"Workers",
			"Durable Objects",
			"D1",
			"R2",
			"Workers AI"
		],
		"bindings": {
			"EMAIL_ADDRESSES": {
				"description": "The addresses that get a mailbox, comma-separated (e.g. `hello@example.com,billing@example.com`). Each must belong to a domain in `DOMAINS`. Mail to any other address bounces."
			},
			"POLICY_AUD": {
				"description": "Cloudflare Access application audience tag. Leave the placeholder for now: turn on Access for the Worker after the deploy and set the value it shows. Every request is refused until then."
			},
			"TEAM_DOMAIN": {
				"description": "Your Cloudflare Access team URL, with `https://`. Leave the placeholder for now and set it with `POLICY_AUD` after the deploy."
			},
			"DOMAINS": {
				"description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
			}
		}
	},
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "node scripts/check-env.mjs && ([ -f build/server/wrangler.json ] || (echo 'Run npm run build first.' >&2; exit 1)) && wrangler d1 migrations apply DB --remote -c \"${PLARAMAIL_WRANGLER_CONFIG:-wrangler.jsonc}\" && wrangler deploy",
		"smoke": "bash scripts/smoke.sh",
		"smoke:mail": "node scripts/smoke-mail.mjs",
		"dev": "react-router dev",
		"dev:local": "PLARAMAIL_WRANGLER_CONFIG=wrangler.local.jsonc react-router dev",
		"preview": "npm run build && vite preview",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"test": "node --test tests/*.test.mjs",
		"test:build": "node --test --test-concurrency=1 tests/builds/*.test.mjs",
		"test:browser": "playwright test"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^2.0.94",
		"@cloudflare/ai-chat": "^0.1.9",
		"@cloudflare/kumo": "^1.19.0",
		"@cloudflare/workers-oauth-provider": "1.2.4",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.108.2",
		"@tanstack/react-virtual": "3.14.27",
		"@tiptap/extension-color": "3.35.0",
		"@tiptap/extension-highlight": "3.35.0",
		"@tiptap/extension-image": "3.35.0",
		"@tiptap/extension-link": "3.35.0",
		"@tiptap/extension-text-align": "3.35.0",
		"@tiptap/extension-text-style": "3.35.0",
		"@tiptap/extension-underline": "3.35.0",
		"@tiptap/react": "3.35.0",
		"@tiptap/starter-kit": "3.35.0",
		"agents": "^0.7.9",
		"ai": "^6.0.333",
		"dompurify": "^3.5.0",
		"hono": "^4.13.20",
		"isbot": "^5.2.3",
		"jose": "^6.2.18",
		"postal-mime": "^2.7.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"react-router": "^7.18.6",
		"remark-gfm": "^4.0.1",
		"workers-ai-provider": "^3.3.1",
		"zod": "^3.25.76",
		"zustand": "^5.1.0"
	},
	"overrides": {
		"@cloudflare/kumo": {
			"zod": "$zod"
		},
		"@tiptap/core": "3.35.0",
		"@tiptap/pm": "3.35.0",
		"@tiptap/extensions": "3.35.0",
		"@tiptap/extension-blockquote": "3.35.0",
		"@tiptap/extension-bold": "3.35.0",
		"@tiptap/extension-bubble-menu": "3.35.0",
		"@tiptap/extension-bullet-list": "3.35.0",
		"@tiptap/extension-code": "3.35.0",
		"@tiptap/extension-code-block": "3.35.0",
		"@tiptap/extension-document": "3.35.0",
		"@tiptap/extension-dropcursor": "3.35.0",
		"@tiptap/extension-floating-menu": "3.35.0",
		"@tiptap/extension-gapcursor": "3.35.0",
		"@tiptap/extension-hard-break": "3.35.0",
		"@tiptap/extension-heading": "3.35.0",
		"@tiptap/extension-horizontal-rule": "3.35.0",
		"@tiptap/extension-italic": "3.35.0",
		"@tiptap/extension-list": "3.35.0",
		"@tiptap/extension-list-item": "3.35.0",
		"@tiptap/extension-list-keymap": "3.35.0",
		"@tiptap/extension-ordered-list": "3.35.0",
		"@tiptap/extension-paragraph": "3.35.0",
		"@tiptap/extension-strike": "3.35.0",
		"@tiptap/extension-text": "3.35.0",
		"partyserver": {
			"@cloudflare/workers-types": "$@cloudflare/workers-types"
		},
		"@modelcontextprotocol/sdk": "1.32.2",
		"undici@7": "7.30.2",
		"sharp": "0.35.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.70.1",
		"@cloudflare/workers-types": "^5.20261121.1",
		"@playwright/test": "1.65.1",
		"@react-router/dev": "^7.18.6",
		"@tailwindcss/vite": "^4.3.5",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^20.19.43",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"esbuild": "^0.25.12",
		"miniflare": "^4.20260730.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^5.8.3",
		"vite": "^6.4.6",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "4.166.0"
	}
}
