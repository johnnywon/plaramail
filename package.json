{
	"name": "pluramail",
	"version": "0.9.2",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"cloudflare": {
		"label": "PluraMail",
		"products": [
			"Workers",
			"Durable Objects",
			"D1",
			"R2",
			"Workers AI"
		],
		"bindings": {
			"EMAIL_ADDRESSES": {
				"description": "The addresses that get a mailbox, comma-separated (e.g. `hello@example.com,billing@example.com`). Each must belong to a domain in `DOMAINS`. Mail to any other address bounces."
			},
			"POLICY_AUD": {
				"description": "Cloudflare Access application audience tag. Leave the placeholder for now: turn on Access for the Worker after the deploy and set the value it shows. Every request is refused until then."
			},
			"TEAM_DOMAIN": {
				"description": "Your Cloudflare Access team URL, with `https://`. Leave the placeholder for now and set it with `POLICY_AUD` after the deploy."
			},
			"DOMAINS": {
				"description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
			}
		}
	},
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "[ -f build/server/wrangler.json ] || (echo 'Run npm run build first.' >&2; exit 1) && wrangler d1 migrations apply DB --remote -c \"${PLURAMAIL_WRANGLER_CONFIG:-wrangler.jsonc}\" && wrangler deploy",
		"smoke": "bash scripts/smoke.sh",
		"smoke:mail": "node scripts/smoke-mail.mjs",
		"dev": "react-router dev",
		"dev:local": "PLURAMAIL_WRANGLER_CONFIG=wrangler.local.jsonc react-router dev",
		"preview": "npm run build && vite preview",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"test": "node --test tests/*.test.mjs",
		"test:build": "node --test --test-concurrency=1 tests/builds/*.test.mjs"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^2.0.81",
		"@cloudflare/ai-chat": "^0.1.8",
		"@cloudflare/kumo": "^1.13.0",
		"@cloudflare/workers-oauth-provider": "1.2.3",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.99.0",
		"@tanstack/react-virtual": "3.14.13",
		"@tiptap/extension-color": "3.20.2",
		"@tiptap/extension-highlight": "3.20.2",
		"@tiptap/extension-image": "3.20.2",
		"@tiptap/extension-link": "3.20.2",
		"@tiptap/extension-text-align": "3.20.2",
		"@tiptap/extension-text-style": "3.20.2",
		"@tiptap/extension-underline": "3.20.2",
		"@tiptap/react": "3.20.2",
		"@tiptap/starter-kit": "3.20.2",
		"agents": "^0.7.6",
		"ai": "^6.0.116",
		"dompurify": "^3.3.3",
		"hono": "^4.7.11",
		"isbot": "^5.1.27",
		"jose": "^6.2.1",
		"postal-mime": "^2.6.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"react-router": "^7.5.3",
		"remark-gfm": "^4.0.1",
		"workers-ai-provider": "^3.1.2",
		"zod": "^3.25.76",
		"zustand": "^5.0.12"
	},
	"overrides": {
		"@cloudflare/kumo": {
			"zod": "$zod"
		},
		"@tiptap/core": "3.20.2",
		"@tiptap/pm": "3.20.2",
		"@tiptap/extensions": "3.20.2",
		"@tiptap/extension-blockquote": "3.20.2",
		"@tiptap/extension-bold": "3.20.2",
		"@tiptap/extension-bubble-menu": "3.20.2",
		"@tiptap/extension-bullet-list": "3.20.2",
		"@tiptap/extension-code": "3.20.2",
		"@tiptap/extension-code-block": "3.20.2",
		"@tiptap/extension-document": "3.20.2",
		"@tiptap/extension-dropcursor": "3.20.2",
		"@tiptap/extension-floating-menu": "3.20.2",
		"@tiptap/extension-gapcursor": "3.20.2",
		"@tiptap/extension-hard-break": "3.20.2",
		"@tiptap/extension-heading": "3.20.2",
		"@tiptap/extension-horizontal-rule": "3.20.2",
		"@tiptap/extension-italic": "3.20.2",
		"@tiptap/extension-list": "3.20.2",
		"@tiptap/extension-list-item": "3.20.2",
		"@tiptap/extension-list-keymap": "3.20.2",
		"@tiptap/extension-ordered-list": "3.20.2",
		"@tiptap/extension-paragraph": "3.20.2",
		"@tiptap/extension-strike": "3.20.2",
		"@tiptap/extension-text": "3.20.2",
		"partyserver": {
			"@cloudflare/workers-types": "$@cloudflare/workers-types"
		}
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.49.0",
		"@cloudflare/workers-types": "^5.20260730.1",
		"@react-router/dev": "^7.5.3",
		"@tailwindcss/vite": "^4.1.4",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^20.19.37",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"esbuild": "^0.25.12",
		"tailwindcss": "^4.1.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.3",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "4.116.0"
	}
}
