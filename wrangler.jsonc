{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plaramail",
	// Set to your Cloudflare account ID, or remove to have wrangler ask.
	// "account_id": "<your-account-id>",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	// global_fetch_strictly_public lets MCP clients sign in with a Client ID Metadata Document URL (docs/mcp.md).
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		// Display name in page titles. Icons and the link preview card live in public/brand/.
		"APP_NAME": "PlaraMail",
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN must include https://; it may be the base Access URL or full /cdn-cgi/access/certs URL.
		// The worker now fails closed outside local development if Access is not configured.
		"DOMAINS": "example.com",
		"EMAIL_ADDRESSES": ["hello@example.com"]
	},
	// Sends scheduled mail and, with ATTACHMENT_SEARCH on, makes attachments searchable.
	"triggers": {
		"crons": ["* * * * *"]
	},
	// Serve the app on your own hostname. Without a route it answers on workers.dev.
	// "routes": [{ "pattern": "mail.example.com", "custom_domain": true }],
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "plaramail",
			"preview_bucket_name": "plaramail"
		}
	],
	// npm run deploy applies the migrations before it deploys. The Deploy to Cloudflare button
	// creates the database and fills in database_id; by hand, run npx wrangler d1 create plaramail.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plaramail",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	// The running version and its deploy time, for the console colophon's uptime.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// OAuth for the MCP server: registered clients, grants and tokens (workers/mcp/oauth.ts).
	// Deploy and the Deploy to Cloudflare button create the namespace.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV"
		}
	],
	// Optional: run agent drafts on a queue that retries a failed draft
	// three times with backoff, then moves it to a dead-letter queue. Without it, each draft is
	// tried once. Create both queues (npx wrangler queues create plaramail-drafts, and
	// plaramail-drafts-dlq), then uncomment. Keep max_retries at 3 (workers/agent/runs.ts).
	// "queues": {
	// 	"producers": [{ "binding": "DRAFT_QUEUE", "queue": "plaramail-drafts" }],
	// 	"consumers": [{ "queue": "plaramail-drafts", "max_batch_size": 5, "max_retries": 3, "dead_letter_queue": "plaramail-drafts-dlq" }]
	// },
	"durable_objects": {
		"bindings": [
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"MailIndexDO"
			]
		},
		{
			// Deletes the Durable Object mail storage from 0.5 and earlier, and the mail in it.
			"tag": "v5",
			"deleted_classes": [
				"MailboxDO",
				"MailIndexDO"
			]
		}
	]
}
